# ============================================================
# Data & output directories (ignored wherever they appear)
# ============================================================
Data_raw/
Data_processed/
models/
# add any other known data/output folder names here
# ============================================================
# R / RStudio
# ============================================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rapp.history
*.Rproj            # remove this line if you want to track the .Rproj
*-Ex.R             # example scripts from R CMD check
/*.tar.gz          # package build tarballs
/*.Rcheck/
.httr-oauth        # cached OAuth tokens (googledrive etc.)
# ============================================================
# renv (ignore the library cache, KEEP renv.lock tracked)
# ============================================================
renv/library/
renv/local/
renv/cellar/
renv/python/
renv/staging/
# renv.lock is intentionally NOT ignored
# ============================================================
# R Markdown / Quarto rendered output (major bloat source)
# ============================================================
*.html
*.knit.md
*.utf8.md
*_files/           # auto-created figure/asset folders
*_cache/           # knitr cache
/.quarto/
